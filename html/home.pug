doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title MEexplorer
    // Semantic UI CSS

    script(src="https://code.jquery.com/jquery-3.7.1.min.js")
    script(src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js")

    script(src="https://cdn.jsdelivr.net/npm/semantic-ui@2.4.1/dist/semantic.min.js")
    link(rel="stylesheet" type="text/css" href="/style/style.css")
    link(rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/semantic-ui@2.4.1/dist/semantic.min.css")
    link(rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css")

  body
    #headline-container.ui.inverted.segment
      h1#headline.ui.header.centered MEexplorer
    //- .four.wide.column
    //-   #control-vis.ui.container.fluid.raised.segment
    
    .ui.grid
      .one.wide.column
      .two.wide.column
        div.ui.buttons
          button.ui.button#sim_button Similarity
          button.ui.button#consensus_button Consensus
      .thirteen.wide.column
        .ui.grid
          .one.wide.column
            h4.ui.header Feature Threshold:
          .column.eight.wide
            .ui.grid
              .row
                .column.align-left1
                  span.min-value1 0
                .column.align-right1
                  span.max-value2 437
            .ui.range.slider#threshold-slider2
              .slider-tooltip 0  // Tooltip placed here, after the slider
              .current-value-container1
                span.current-value1

      .six.wide.column
        #scatter-vis.ui.container.fluid.raised.segment
          .ui.grid
            .three.wide.column
              #label0 Pathogenic:
            .four.wide.column
              #legend-color
              #legend-labels
            .four.wide.column
              #label1 Non-Pathogenic:
            .four.wide.column
              section#legend-color1
              section#legend-labels1
          //#legend-wrapper.ui.raised.segment
          //
          //
          //#legend-wrapper1.ui.raised.segment
          //  section#legend-color1
          //  section#legend-labels1
        .ui.grid
          .row
            .eight.wide.column
              #heat-vis.ui.container.fluid.raised.segment

                select.ui.selection.dropdown#metric_type
                  option(value="f1") F1
                  option(value="accuracy") Accuracy
                #hover
            .eight.wide.column
                #histogram-vis.ui.container.fluid.raised.segment

      
      .eight.wide.column
        #motif-container.ui.raised.segment
          //.horizontal-scrollbar
          #accordion-wrapper.ui.container.fluid.raised.segment

          #model-wrapper.ui.container.fluid.raised.segment

    
    // Your custom scripts here
    //script(src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous")

    script(src="https://cdn.jsdelivr.net/npm/vega")
    script(type="module" src="utils.js")
    script(src="mathss.js")
    //- script(src="https://code.jquery.com/jquery-3.6.0.min.js")

    // Include D3.js
    //- script(src="https://d3js.org/d3.v6.min.js")
    // Include Observable's standard library
    script(src="https://unpkg.com/@observablehq/stdlib@3.24.0/dist/stdlib.js")
    // Include Vega-Lite
    script(src="https://cdn.jsdelivr.net/npm/vega-lite")
    // Include Vega-Lite API
    script(src="https://cdn.jsdelivr.net/npm/vega-lite-api")
    //- script(src="https://d3js.org/d3.v3.min.js")
    // Include Vega-Tooltip
    script(src="https://cdn.jsdelivr.net/npm/vega-tooltip")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/mathjs/11.9.0/math.min.js")
    script(src="https://cdn.jsdelivr.net/npm/d3@7")
    script(src="https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6")
    script(src="https://cdn.jsdelivr.net/npm/@observablehq/inputs")
    script(src="https://cdn.jsdelivr.net/npm/htl@0.3.1/dist/htl.js")
    script(src="https://cdn.jsdelivr.net/npm/@observablehq/inputs@0.10.4/dist/inputs.js")
    script(src="https://cdn.jsdelivr.net/npm/d3-color-legend@1.4.1/+esm")
    //- script(src="https://d3js.org/d3.v3.min.js")
    
  .script 

