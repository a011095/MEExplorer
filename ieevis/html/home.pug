doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title MotifVis 2024
    // Semantic UI CSS

    script(src="https://code.jquery.com/jquery-3.2.1.min.js")
    script(src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js")

    script(src="https://cdn.jsdelivr.net/npm/semantic-ui@2.4.1/dist/semantic.min.js")
    link(rel="stylesheet" type="text/css" href="/style/style.css")
    link(rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/semantic-ui@2.4.1/dist/semantic.min.css")
    link(rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css")

  body
    #headline-container.ui.inverted.segment
      h1#headline.ui.header.centered MotifVis
    //- .four.wide.column
    //-   #control-vis.ui.container.fluid.raised.segment
    
    .ui.grid
      .sixteen.wide.column
        #control-vis.ui.container.fluid.raised.segment
          div.ui.buttons
            button.ui.button.active#sim_button Similarity
            button.ui.button#consensus_button Consensus

          .slider-container2
            h4.ui.header Feature Threshold
            .ui.grid
              .row
                .column.align-left1
                  span.min-value1 0
                .column.align-right1
                  span.max-value2 150
            .ui.range.slider#threshold-slider2
            .slider-tooltip 0  // Tooltip placed here, after the slider
            .current-value-container1
              span.current-value1
        //- .slider-container
        //-   h4.ui.header Motif Distance
        //-   .ui.grid
        //-     .row
        //-       .column.align-left
        //-         span.min-value 0
        //-       .column.align-right
        //-         span.max-value 2620
        //-   #threshold-slider.ui.range.slider
        //-   .current-value-container
        //-     span.current-value
        
        

        //- .slider-container2
        //-   h4.ui.header Feature Selector
        //-   .ui.grid
        //-     .row
        //-       .column.align-left
        //-         span.min-value 0
        //-       .column.align-right
        //-         span.max-value 30
        //-   #threshold-slider2.ui.range.slider
        //-   .current-value-container
        //-     span.current-value

        
        
      
      .six.wide.column
        #scatter-vis.ui.container.fluid.raised.segment
          #label0 Pathogenic
          #legend-wrapper.ui.raised.segment
            section#legend-color
            section#legend-labels
          #label1 Non-Pathogenic
          #legend-wrapper1.ui.raised.segment 
            section#legend-color1
            section#legend-labels1
        #heat-vis.ui.container.fluid.raised.segment 
          
          select.ui.selection.dropdown#metric_type
            option(value="f1") F1
            option(value="accuracy") Accuracy
      
      .eight.wide.column
        #motif-container.ui.raised.segment

          #accordion-wrapper.ui.container.fluid.raised.segment
           
          #model-wrapper.ui.container.fluid.raised.segment          

    
