      .six.wide.column
        #scatter-vis.ui.container.fluid.raised.segment
          #label0 Pathogenic
          #legend-wrapper.ui.raised.segment
            section#legend-color
            section#legend-labels
          #label1 Non-Pathogenic
          #legend-wrapper1.ui.raised.segment 
            section#legend-color1
            section#legend-labels1
        #heat-vis.ui.container.fluid.raised.segment 
          
          select.ui.selection.dropdown#metric_type
            option(value="f1") F1
            option(value="accuracy") Accuracy
      
      .eight.wide.column
        #motif-container.ui.raised.segment

          #accordion-wrapper.ui.container.fluid.raised.segment
           
          #model-wrapper.ui.container.fluid.raised.segment          

    
