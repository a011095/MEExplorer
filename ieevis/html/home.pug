doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title MotifVis 2024
    // Semantic UI CSS
    script(src="https://code.jquery.com/jquery-3.2.1.min.js")
    script(src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js")

    script(src="https://cdn.jsdelivr.net/npm/semantic-ui@2.4.1/dist/semantic.min.js")
    link(rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/semantic-ui@2.4.1/dist/semantic.min.css")
    link(rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css")

    style.
      #heat-vis{
        width: 85vw;
        height: 250px;
        border: 1px solid white;
        margin-top: 10px;
        position: relative;
        float: left;
        margin-left: 0px;
        margin-right: auto;
        left: 10px;
      }

      #controls {
        font-size: 14px;
        position: absolute;
        top: 220px;
        left: 730px;
      }

      #data-vis{
        width: 95vw;
        height: 80vw;
        border: 1px solid blue;
        margin-top: 10px;
        position: relative;
        float: left;
        margin-left: 0px;
        margin-right: auto;
      }
      #hover{
        width: 270px;
        height: 40px;
        border: 1px solid white;
        float: left;
        position:absolute;
        bottom:0;
        left:0;

      }

      #button-container{
        width: 250px;
        height: 65px;
        border: 1px solid white;
        position:absolute;
        bottom:0;
        right:0;
        left:0px

      }
      #button-container2{
        width: 40vw;
        height: 60px;
        border: 1px solid white;
        position:absolute;
        bottom:-50px;
        right:160px;
        left:0;

      }

      #scatter-vis {
          width: 98vw;
          height: 900px;
          border: 1px solid white;
          margin-top: 10px;
          //- position: relative;
          float: left;
          margin-left: auto;
          margin-right: auto;
          left: 10px;
      }
      #control-vis {
          width: 80vw;
          height: 80px;
          border: 1px solid white;
          margin-top: 10px;
          position: relative;
          float: left;
          margin-left: auto;
          margin-right: auto;
          left: 10px;
      }

      #motif-container {
          width: 50vw;
          height: 1180px;
          border: 1px solid white;
          margin-top: 10px;
          //- position: relative;
          float: left;
          margin-left: 15px;
          overflow-y: auto;
          left: 90px;

      }
      #legend-wrapper{
        width: 150px;
        height: 30px;
        border: 1px solid white;
        float: left;
        position:absolute;
        top:0px;
        left:130px;

      }
      #legend-wrapper1{
        width: 150px;
        height: 30px;
        border: 1px solid white;
        float: left;
        position:absolute;
        top:45px;
        left:130px;

      }
      #accordion-wrapper{
        width: 80vw;
        height: 300px;
        border: 1px solid white;
        float: left;
        position:absolute;
        bottom:-10px;
        left:10px;

      }

      #model-wrapper{
        width: 95vw;
        height: 800px;
        border: 1px solid white;
        float: left;
        position:absolute;
        bottom:0px;
        left:10px;
        overflow-y: auto;
        top:10px;

      }
      #legend-wrapper3{
        width: 290px;
        height: 40px;
        border: 1px solid white;
        float: left;
        position:absolute;
        bottom:10px;
        left:250px;

      }
      #legend-wrapper4{
        width: 290px;
        height: 40px;
        border: 1px solid white;
        float: left;
        position:absolute;
        bottom:22px;
        left:590px;

      }
       #legend-color3 {
        width: 100%; /* Occupy full width of legend-wrapper */
        height: 40px; /* Adjust height as needed */
        border: 1px solid white;
      }
       #legend-color4 {
        width: 100%; /* Occupy full width of legend-wrapper */
        height: 40px; /* Adjust height as needed */
        border: 1px solid white;
      }
      #legend-color {
        width: 100%; /* Occupy full width of legend-wrapper */
        height: 40px; /* Adjust height as needed */
        border: 1px solid white;
        margin-top:-10px;
      }
      #legend-color1 {
        width: 100%; /* Occupy full width of legend-wrapper */
        height: 30px; /* Adjust height as needed */
        border: 1px solid white;
         margin-top:-10px;
      }

      #legend-labels {
          width: 100%; /* Occupy full width of legend-wrapper */
          display: flex;
          justify-content: space-between;
          position: relative;
          top: 5px; /* Adjust the distance between the color bar and the labels */
      }
      #legend-labels3{
          width: 100%; /* Occupy full width of legend-wrapper */
          display: flex;
          justify-content: space-between;
          position: relative;
          top: 5px; /* Adjust the distance between the color bar and the labels */
      }
      #legend-labels4{
          width: 100%; /* Occupy full width of legend-wrapper */
          display: flex;
          justify-content: space-between;
          position: relative;
          top: 5px; /* Adjust the distance between the color bar and the labels */
      }
      #legend-labels1 {
          width: 100%; /* Occupy full width of legend-wrapper */
          display: flex;
          justify-content: space-between;
          position: relative;
          top: 5px; /* Adjust the distance between the color bar and the labels */
      }
      .model-overview {
        background-color: gray; /* Sets the background color to blue */
      }
      .acc-overview {
        align-items: center; /* Sets the background color to blue */
        display: flex;
        justify-content: center; 
      }
      #button-container2 .slider-values {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .align-left {
        text-align: left;
        bottom:-10px;
      }
      .align-left1 {
        text-align: left;
        bottom:-14px;
        right:10px
      }

      .align-right {
        text-align: right; /* Ensures content within the element is aligned to the right */
        position: absolute; /* Allows the element to be positioned relative to its nearest positioned ancestor */
        left: 13vw; /* Aligns the element to the far right of the nearest positioned container */
        bottom: -10px; /* Positions the element 10px below the bottom edge of the container */
        border: 1px solid white;
      }
       .align-right1 {
        text-align: right; /* Ensures content within the element is aligned to the right */
        position: absolute; /* Allows the element to be positioned relative to its nearest positioned ancestor */
        left: 15vw; /* Aligns the element to the far right of the nearest positioned container */
        bottom: -14px; /* Positions the element 10px below the bottom edge of the container */
        border: 1px solid white;
      }

      .slider-container {
        display: flex;
        flex-direction: column;
        left: calc(-25vw);
        position: relative;
        margin-top: 20px;
        border: 1px solid white;
      }

      .slider-container2 {
        display: flex;
        width: 300px;
        flex-direction: column;
        left: 450px;
        position: relative;
        margin-top: -40px;
        border: 1px solid white;
      }

      #threshold-slider.ui.range.slider {
        width: 90%;  /* Ensures the slider takes full width of its container */
        left:20px;
        bottom:20px;

      }

      #threshold-slider2.ui.range.slider {
        width: 90%;  /* Ensures the slider takes full width of its container */
        left:10px;
        bottom:1px;

      }

      .current-value-container {
        width: 90%;
        border: 1px solid white;


        text-align: center; /* or whatever alignment you need for the current value */
        margin-top:-20px;
      }

      .current-value-container1 {
        width: 90%;
        border: 1px solid white;

        text-align: center; /* or whatever alignment you need for the current value */
        margin-top:-20px;
      }
      #label0 {
        position: absolute;
        left: 20px; /* Adjust as needed to place the label to the left of the container */
        top: 20px;
         /* Centers the label vertically relative to the container */
      }
       #label1 {
        position: absolute;
        left: 20px; /* Adjust as needed to place the label to the left of the container */
        top: 70px;
         /* Centers the label vertically relative to the container */
      }
      .slider-tooltip {
        position: absolute;
        top: 14px; /* Adjust this to place the tooltip above the handle */
        transform: translateX(-5%); /* Center the tooltip on the handle */
        background-color: #007bff; /* Your tooltip background color */
        color: white; /* Text color */
        padding: 5px 10px;
        border-radius: 10px;
        font-size: 1rem;
        white-space: nowrap;
      
      }


    

  body
    #headline-container.ui.inverted.segment
      h1#headline.ui.header.centered MotifVis
    //- .four.wide.column
    //-   #control-vis.ui.container.fluid.raised.segment
    
    .ui.grid
      .sixteen.wide.column
        #control-vis.ui.container.fluid.raised.segment
          div.ui.buttons
            button.ui.button.active#sim_button Similarity
            button.ui.button#consensus_button Consensus

          .slider-container2
            h4.ui.header Feature Threshold
            .ui.grid
              .row
                .column.align-left1
                  span.min-value1 0
                .column.align-right1
                  span.max-value2 150
            .ui.range.slider#threshold-slider2
            .slider-tooltip 0  // Tooltip placed here, after the slider
            .current-value-container1
              span.current-value1
